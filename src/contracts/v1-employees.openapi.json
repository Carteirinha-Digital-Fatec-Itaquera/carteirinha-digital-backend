{
  "openapi": "3.1.0",
  "info": {
    "title": "Carteirinha Digital Fatec Itaquera — API de Funcionários V1",
    "version": "1.0.0",
    "description": "Contrato HTTP V1 para o portal dos funcionários, gestão na Secretaria, validação pública, importação CSV/XLSX, eventos, certificados, suporte e presença offline."
  },
  "paths": {
    "/autenticacao/funcionarios/login": {
      "post": {
        "summary": "Login de funcionário",
        "tags": [
          "Autenticação"
        ],
        "description": "Primeiro acesso: envie o e-mail cadastrado e a matrícula em password. Uma conta ativa sem senha recebe somente autorização de uso único válida por 10 minutos. Após definir senha pessoal, o login emite uma sessão e rejeita a matrícula.",
        "responses": {
          "200": {
            "description": "Sessão de funcionário ou autorização de primeiro acesso",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "mustChangePassword",
                        "token",
                        "profileType",
                        "expiresAt"
                      ],
                      "properties": {
                        "mustChangePassword": {
                          "type": "boolean",
                          "enum": [
                            false
                          ]
                        },
                        "token": {
                          "type": "string"
                        },
                        "profileType": {
                          "type": "string",
                          "enum": [
                            "employee"
                          ]
                        },
                        "expiresAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "mustChangePassword",
                        "firstAccessToken",
                        "profileType",
                        "expiresAt"
                      ],
                      "properties": {
                        "mustChangePassword": {
                          "type": "boolean",
                          "enum": [
                            true
                          ]
                        },
                        "firstAccessToken": {
                          "type": "string"
                        },
                        "profileType": {
                          "type": "string",
                          "enum": [
                            "employee"
                          ]
                        },
                        "expiresAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "E-mail ou senha inválidos"
          },
          "429": {
            "description": "Limite de tentativas"
          }
        }
      }
    },
