generator client {
  provider     = "prisma-client-js"
  output       = "../node_modules/.prisma/client"
  moduleFormat = "cjs"
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  WAITING_STUDENT
  RESOLVED
  CLOSED
}

enum SupportCategory {
  DATA
  PHOTO_CARD
  EVENT
  CERTIFICATE
  ACCESS
  OTHER
}

model SupportTicket {
  deletedAt DateTime?
  id                   String           @id @default(uuid())
  protocol             String           @unique
  requestId            String
  requestHash          String
  ownerIdentity          String
  ownerAccountId         String?
  owner                  Student?         @relation("SupportOwner", fields: [ownerAccountId], references: [accountId], onDelete: SetNull)
  ownerEmployeeAccountId String?
  employeeOwner          Employee?        @relation("SupportEmployeeOwner", fields: [ownerEmployeeAccountId], references: [accountId], onDelete: SetNull)
  category             SupportCategory
  subject              String
  requestedField       String?
  proposedValue        String?
  status               SupportStatus    @default(OPEN)
  assignedSecretaryId  Int?
  assignee             Secretary?       @relation("SupportAssignee", fields: [assignedSecretaryId], references: [id], onDelete: SetNull)
  eventId              String?
  event                Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  certificateId        String?
  certificate          Certificate?     @relation(fields: [certificateId], references: [id], onDelete: SetNull)
  version              Int              @default(1)
  studentReadVersion   Int              @default(1)
  secretaryReadVersion Int              @default(0)
  lastActorRole        String           @default("STUDENT")
  closeReason          String?
  resolvedAt           DateTime?
  closedAt             DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  messages             SupportMessage[]
  audits               SupportAudit[]

  @@unique([ownerIdentity, requestId])
  @@index([status, createdAt])
  @@index([ownerAccountId, createdAt])
  @@index([ownerEmployeeAccountId, createdAt])
  @@index([assignedSecretaryId, status])
}

model SupportMessage {
  id              String        @id @default(uuid())
  ticketId        String
  ticket          SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  clientMessageId String
  authorRole      String
  authorIdentity  String
  body            String
  redactedAt      DateTime?
  createdAt       DateTime      @default(now())

  @@unique([ticketId, clientMessageId])
  @@index([ticketId, createdAt])
  @@index([authorIdentity, createdAt])
}

model SupportAudit {
  id                 String         @id @default(uuid())
  ticketId           String
  ticket             SupportTicket  @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  requestId          String
  requestHash        String
  action             String
  actorRole          String
  actorIdentity      String
  previousStatus     SupportStatus?
  nextStatus         SupportStatus?
  previousAssigneeId Int?
  nextAssigneeId     Int?
  reason             String?
  resultReference    String?
  createdAt          DateTime       @default(now())

  @@unique([ticketId, requestId])
  @@index([ticketId, createdAt])
}

datasource db {
  provider = "postgresql"
}

model Student {
  supportTickets  SupportTicket[] @relation("SupportOwner")
  ra              String          @id
  accountId       String          @unique @default(dbgenerated("(gen_random_uuid())::text"))
  course          String
  status          String
  name            String
  socialName      String?
  admission       String
  email           String          @unique
  cpf             String?         @unique
  qrcode          String?         @unique
  photo           String?
  birthDate       DateTime?
  dueDate         DateTime
  password        String
  lastLogin       DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  photoStatus     PhotoStatus     @default(PENDING)
  rejectionReason String?
  attendances     Attendance[]
  certificates    Certificate[]
}

model StudentLog {
  id             Int      @id @default(autoincrement())
  ra             String
  course         String
  status         String
  name           String
  admission      String
  email          String
  cpf            String
  birthDate      DateTime
  dueDate        DateTime
  deletedAt      DateTime @default(now())
  deletionReason String   @default("Prazo de 5 anos após admissão encerrado")
}

model Secretary {
  supportTickets  SupportTicket[]      @relation("SupportAssignee")
  id              Int                  @id @default(autoincrement())
  name            String
  email           String               @unique
  dueDate         DateTime
  password        String
  birthDate       DateTime
  lastLogin       DateTime?
  events                 Event[]               @relation("EventCreatedBy")
  cancelledEvents        Event[]               @relation("EventCancelledBy")
  creditAudits           ProjectCreditAudit[]
  approvedEmployeePhotos EmployeePhoto[]       @relation("EmployeePhotoApprovedBy")
  employeeImportBatches  EmployeeImportBatch[] @relation("EmployeeImportBatchSecretary")
}

model Event {
  supportTickets      SupportTicket[]
  locationEnabled     Boolean            @default(false)
  attendanceMode      String             @default("FINAL_ONLY")
  id                  String             @id @default(uuid())
  title               String
  description         String?
  speaker             String
  location            String
  startsAt            DateTime
  endsAt              DateTime
  workloadMinutes     Int
  status              EventStatus        @default(SCHEDULED)
  certificateEnabled  Boolean            @default(true)
  seriesId            String?
  series              EventSeries?       @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  visitorsAllowed     Boolean            @default(false)
  organizerCourse     String?
  promoter            String?
  windowMinutes       Int?
  geoPolicy           Json?
  certificatePolicies Json?
  participants        EventParticipant[]
  createdById         Int?
  createdBy           Secretary?         @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelReason        String?
  cancelledAt         DateTime?
  cancelledById       Int?
  cancelledBy         Secretary?         @relation("EventCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  attendancePublicReference String? @unique
  checkpoints         EventCheckpoint[]
  attendances         Attendance[]
  certificates        Certificate[]
  feedbacks           EventFeedback[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([createdById])
  @@index([cancelledById])
}

model EventCheckpoint {
  id           String                  @id @default(uuid())
  eventId      String
  event        Event                   @relation(fields: [eventId], references: [id], onDelete: Restrict)
  type         CheckpointType
  isOpen       Boolean                 @default(false)
  openedAt     DateTime?
  closedAt     DateTime?
  closesAt     DateTime?
  version      Int                     @default(1)
  qrReferences AttendanceQrReference[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@unique([eventId, type])
}

model AttendanceQrReference {
  id                String          @id @default(uuid())
  referenceHash     String          @unique
  checkpointId      String
  checkpoint        EventCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  checkpointVersion Int
  jwtToken          String
  expiresAt         DateTime?
  createdAt         DateTime        @default(now())

  @@index([expiresAt])
  @@index([checkpointId, checkpointVersion])
}

model Attendance {
  id               String            @id @default(uuid())
  eventId          String
  event            Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  studentRa        String?
  studentName      String
  studentCourse    String
  studentAccountId String?
  participantId    String?           @unique
  participant      EventParticipant? @relation(fields: [participantId, eventId], references: [id, eventId], onDelete: Restrict, onUpdate: Restrict, map: "attendance_participant_event")
  evidence         Json?
  studentRefRa     String?
  student          Student?          @relation(fields: [studentRefRa], references: [ra], onDelete: SetNull)
  checkInAt        DateTime?
  checkOutAt       DateTime?
  status           AttendanceStatus  @default(CHECKED_IN)
  certificate      Certificate?      @relation("CurrentAttendanceCertificate")
  certificates     Certificate[]     @relation("AttendanceCertificateHistory")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([eventId, studentRa])
  @@unique([participantId, eventId])
  @@index([studentRefRa, studentAccountId])
}

model Certificate {
  supportTickets   SupportTicket[]
  id               String               @id @default(uuid())
  eventId          String
  event            Event                @relation(fields: [eventId], references: [id], onDelete: Restrict)
  studentRa        String?
  studentAccountId String?
  participantId    String?
  participant      EventParticipant?    @relation("ParticipantCertificateHistory", fields: [participantId, eventId], references: [id, eventId], onDelete: Restrict, onUpdate: Restrict, map: "certificate_participant_event")
  artifact         CertificateArtifact?
  studentRefRa     String?
  student          Student?             @relation(fields: [studentRefRa], references: [ra], onDelete: SetNull)
  attendanceId     String
  attendance       Attendance           @relation("AttendanceCertificateHistory", fields: [attendanceId], references: [id], onDelete: Restrict)
  verificationCode String               @unique
  payloadSnapshot  Json
  issuedAt         DateTime             @default(now())
  revokedAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  activeAttendanceId  String?           @unique
  activeAttendance    Attendance?       @relation("CurrentAttendanceCertificate", fields: [activeAttendanceId], references: [id], onDelete: Restrict)
  activeParticipantId String?           @unique
  activeParticipant   EventParticipant? @relation("CurrentParticipantCertificate", fields: [activeParticipantId], references: [id], onDelete: Restrict)
  version             Int               @default(1)
  replacesId          String?           @unique
  previous            Certificate?      @relation("CertificateVersions", fields: [replacesId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replacement         Certificate?      @relation("CertificateVersions")
  reissueKey          String?           @unique
  revocationReason    String?
  reissuedById        Int?

  @@unique([attendanceId, version])
  @@index([studentRefRa, studentAccountId])
}

model EventSeries {
  id          String                @id @default(uuid())
  slug        String                @unique
  title       String
  startsAt    DateTime
  endsAt      DateTime
  retentionAt DateTime
  published   Boolean               @default(false)
  cpfRequired Boolean               @default(false)
  isAutomatic Boolean               @default(false)
  courses     String[]
  purgedAt    DateTime?
  events      Event[]
  visitors    VisitorRegistration[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model VisitorRegistration {
  id              String             @id @default(uuid())
  seriesId        String
  series          EventSeries        @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  name            String
  email           String?
  emailHash       String?
  course          String?
  cpfHash         String?
  identifiedAt    DateTime?
  verifiedAt      DateTime?
  otpHash         String?
  otpExpiresAt    DateTime?
  otpAttempts     Int                @default(0)
  lastChallengeAt DateTime?
  sessions        VisitorSession[]
  participants    EventParticipant[]
  createdAt       DateTime           @default(now())

  @@unique([seriesId, emailHash])
  @@unique([seriesId, cpfHash])
}

model VisitorSession {
  id        String              @id @default(uuid())
  tokenHash String              @unique
  visitorId String
  visitor   VisitorRegistration @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime            @default(now())

  @@index([expiresAt])
}

model EventParticipant {
  id                String               @id @default(uuid())
  eventId           String
  event             Event                @relation(fields: [eventId], references: [id], onDelete: Restrict)
  visitorId         String?
  visitor           VisitorRegistration? @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  accountId         String?
  employeeAccountId String?
  employee          Employee?            @relation(fields: [employeeAccountId], references: [accountId], onDelete: SetNull)
  name              String
  course            String?
  role              String               @default("ATTENDEE")
  attendance        Attendance?
  certificate       Certificate?         @relation("CurrentParticipantCertificate")
  certificates      Certificate[]        @relation("ParticipantCertificateHistory")
  createdAt         DateTime             @default(now())

  @@unique([eventId, visitorId])
  @@unique([eventId, accountId])
  @@unique([eventId, employeeAccountId])
  @@unique([id, eventId], map: "participant_event_unique")
  @@index([employeeAccountId])
}

model EventFeedback {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rating      Int
  comments    String?
  suggestions String?
  createdAt   DateTime @default(now())

  @@index([eventId])
}

model CertificateTemplate {
  id        String   @id @default(uuid())
  name      String
  role      String
  version   Int
  status    String   @default("DRAFT")
  config    Json
  createdAt DateTime @default(now())

  @@unique([name, role, version])
}

model CertificateSigner {
  id           String   @id @default(uuid())
  name         String
  title        String
  course       String?
  version      Int      @default(1)
  archived     Boolean  @default(false)
  assetId      String
  authorizedAt DateTime
  createdAt    DateTime @default(now())
}

model EventAsset {
  id         String   @id @default(uuid())
  kind       String
  storageKey String   @unique
  sha256     String
  createdAt  DateTime @default(now())
}

model CertificateArtifact {
  id               String      @id @default(uuid())
  certificateId    String      @unique
  certificate      Certificate @relation(fields: [certificateId], references: [id], onDelete: Restrict)
  state            String      @default("PENDING_RENDER")
  storageKey       String?
  sha256           String?
  attempts         Int         @default(0)
  nextAttemptAt    DateTime    @default(now())
  leaseUntil       DateTime?
  leaseToken       String?
  deliveryState    String      @default("PENDING")
  deliveryAttempts Int         @default(0)
  createdAt        DateTime    @default(now())

  @@index([state, nextAttemptAt])
}

model EventAudit {
  id          String   @id @default(uuid())
  eventId     String?
  subjectId   String?
  action      String
  secretaryId Int?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([eventId, createdAt])
}

model EventRateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime
}

model PresenceChallenge {
  id                String   @id @default(uuid())
  identity          String
  eventId           String
  checkpoint        String
  checkpointVersion Int
  expiresAt         DateTime

  @@index([expiresAt])
}

model VerificationCode {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)
}

enum PhotoStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CheckpointType {
  CHECK_IN
  CHECK_OUT
}

enum AttendanceStatus {
  CHECKED_IN
  CONFIRMED
}

enum ProjectContributorStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProjectCreditAuditAction {
  CREATED
  UPDATED
  DRAFT_SAVED
  PUBLISHED
  ARCHIVED
  RESTORED
  PHOTO_REPLACED
  PHOTO_REMOVED
}

enum ProjectCreditAssetStatus {
  PENDING
  PROCESSED
  FAILED
}

enum ProjectContributorLinkKind {
  GITHUB
  LINKEDIN
  EMAIL
  EXTERNAL
}

model ProjectContributor {
  id                String                             @id @default(uuid())
  slug              String                             @unique
  name              String
  status            ProjectContributorStatus           @default(DRAFT)
  draftVersion      Int                                @default(1)
  publishedVersion  Int?
  publishedSnapshot Json?
  photoUrl          String?
  photoStorageKey   String?
  photoPendingKey   String?
  photoConfirmed    Boolean                            @default(false)
  profileConfirmed  Boolean                            @default(false)
  archiveReason     String?
  archivedAt        DateTime?
  publishedAt       DateTime?
  createdAt         DateTime                           @default(now())
  updatedAt         DateTime                           @updatedAt
  participations    ProjectContributionParticipation[]
  links             ProjectContributorLink[]
  audits            ProjectCreditAudit[]

  @@index([status])
  @@index([name])
}

model ProjectContributionParticipation {
  id            String             @id @default(uuid())
  contributorId String
  contributor   ProjectContributor @relation(fields: [contributorId], references: [id], onDelete: Cascade)
  semester      String
  course        String?
  roles         String[]
  contribution  String?
  confirmed     Boolean            @default(false)
  order         Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([contributorId, semester])
  @@index([contributorId])
}

model ProjectContributorLink {
  id            String                     @id @default(uuid())
  contributorId String
  contributor   ProjectContributor         @relation(fields: [contributorId], references: [id], onDelete: Cascade)
  kind          ProjectContributorLinkKind @default(EXTERNAL)
  label         String
  url           String
  order         Int                        @default(0)
  confirmed     Boolean                    @default(false)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@unique([contributorId, url])
  @@index([contributorId])
}

model ProjectCreditAudit {
  id                     String                   @id @default(uuid())
  contributorId          String
  contributor            ProjectContributor       @relation(fields: [contributorId], references: [id], onDelete: Cascade)
  action                 ProjectCreditAuditAction
  performedBySecretaryId Int?
  performedBySecretary   Secretary?               @relation(fields: [performedBySecretaryId], references: [id], onDelete: SetNull)
  performedByName        String?
  beforeSnapshot         Json?
  afterSnapshot          Json?
  metadata               Json?
  createdAt              DateTime                 @default(now())

  @@index([contributorId])
  @@index([performedBySecretaryId])
}

model ProjectCreditAssetCleanup {
  id           String                   @id @default(uuid())
  storageKey   String
  source       String                   @default("CREDITS_PHOTO")
  status       ProjectCreditAssetStatus @default(PENDING)
  attempts     Int                      @default(0)
  lastError    String?
  scheduledFor DateTime                 @default(now())
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([status, scheduledFor])
}

model ManualCertificateOperation {
  requestId String @id
  eventId String
  secretaryId Int
  payloadHash String
  certificateId String
  createdAt DateTime @default(now())
  @@index([eventId, secretaryId])
}

// Scoped, revocable capability; only a hash of the opaque cookie is persisted.
model StudentOfflineSession {
  id        String @id @default(uuid())
  tokenHash String @unique
  accountId String
  studentRa String
  origin    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([accountId, expiresAt])
}

model StudentOfflineReceipt {
  id          String @id @default(uuid())
  accountId   String
  requestId   String
  requestHash String
  reference   String
  scannedAt   DateTime
  receivedAt  DateTime @default(now())
  result      Json

  @@unique([accountId, requestId])
  @@index([receivedAt])
}

enum EmployeeAccountStatus {
  ACTIVE
  BLOCKED
  ARCHIVED
}

enum EmployeePhotoProcessingState {
  UPLOADING
  READY
  FAILED
  DELETE_PENDING
  DELETED
}

enum EmployeeAccessTokenPurpose {
  ACTIVATE
  RESET_PASSWORD
}

enum EmployeeTokenDeliveryState {
  PENDING
  ACCEPTED
  FAILED
  UNKNOWN
}

enum EmployeeImportMode {
  CREATE_ONLY
  UPDATE
}

enum EmployeeImportBatchState {
  ANALYZED
  RUNNING
  COMPLETED
  PARTIAL
  CANCELLED
  EXPIRED
}

enum EmployeeImportRowDecision {
  READY_CREATE
  READY_UPDATE
  EXISTS
  INVALID
  AMBIGUOUS
}

enum EmployeeImportRowState {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  STALE
}

model Employee {
  id                 String                   @id @default(uuid())
  accountId          String                   @unique @default(uuid())
  name               String
  socialName         String?
  searchText         String
  email              String                   @unique
  registrationNumber String?                  @unique
  rg                 String?
  admissionDate      DateTime                 @db.Date
  accountStatus      EmployeeAccountStatus    @default(ACTIVE)
  passwordHash       String?
  authVersion        Int                      @default(1)
  version            Int                      @default(1)
  qrcode             String                   @unique
  lastLoginAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  assignments        EmployeeAssignment[]
  photos             EmployeePhoto[]
  accessTokens       EmployeeAccessToken[]
  audits             EmployeeAudit[]
  eventParticipants  EventParticipant[]
  supportTickets     SupportTicket[]          @relation("SupportEmployeeOwner")
  offlineSessions    EmployeeOfflineSession[]
  offlineReceipts    EmployeeOfflineReceipt[]

  @@index([accountStatus, archivedAt])
  @@index([name, id])
}

model EmployeeAssignment {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  title      String
  startsOn   DateTime? @db.Date
  validUntil DateTime? @db.Date
  active     Boolean   @default(true)
  endedAt    DateTime?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([employeeId, active, archivedAt])
}

model EmployeePhoto {
  id              String                       @id @default(uuid())
  employeeId      String
  employee        Employee                     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  requestId       String
  storageKey      String                       @unique
  reviewStatus    PhotoStatus                  @default(PENDING)
  processingState EmployeePhotoProcessingState @default(UPLOADING)
  currentApproved Boolean                      @default(false)
  currentPending  Boolean                      @default(false)
  version         Int                          @default(1)
  contentHash     String?
  approvedById    Int?
  approvedBy      Secretary?                   @relation("EmployeePhotoApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  reviewReason    String?
  createdAt       DateTime                     @default(now())
  reviewedAt      DateTime?
  cleanupAttempts Int                          @default(0)
  nextCleanupAt   DateTime?

  @@unique([employeeId, requestId])
  @@index([reviewStatus, processingState, createdAt])
  @@index([processingState, nextCleanupAt])
}

model EmployeeAccessToken {
  id            String                     @id @default(uuid())
  employeeId    String
  employee      Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tokenHash     String                     @unique
  purpose       EmployeeAccessTokenPurpose
  authVersion   Int
  expiresAt     DateTime
  usedAt        DateTime?
  deliveryState EmployeeTokenDeliveryState @default(PENDING)
  createdAt     DateTime                   @default(now())

  @@index([employeeId, purpose, createdAt])
  @@index([expiresAt])
}

model EmployeeImportBatch {
  id            String                   @id @default(uuid())
  secretaryId   Int
  secretary     Secretary                @relation("EmployeeImportBatchSecretary", fields: [secretaryId], references: [id], onDelete: Restrict)
  fileHash      String
  schemaVersion String                   @default("1.0")
  mode          EmployeeImportMode       @default(CREATE_ONLY)
  state         EmployeeImportBatchState @default(ANALYZED)
  revision      Int                      @default(1)
  reviewDigest  String
  requestId     String?
  counts        Json
  leaseUntil    DateTime?
  leaseToken    String?
  createdAt     DateTime                 @default(now())
  expiresAt     DateTime
  confirmedAt   DateTime?
  finishedAt    DateTime?
  rows          EmployeeImportRow[]
  audits        EmployeeAudit[]

  @@index([secretaryId, createdAt])
  @@index([state, leaseUntil])
  @@index([expiresAt])
}

model EmployeeImportRow {
  id                      String                    @id @default(uuid())
  batchId                 String
  batch                   EmployeeImportBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber               Int
  groupKey                String
  groupId                 String
  input                   Json
  decision                EmployeeImportRowDecision
  state                   EmployeeImportRowState    @default(PENDING)
  employeeId              String?
  expectedEmployeeVersion Int?
  operationKey            String?                   @unique
  errorCode               String?
  errorMessage            String?
  createdAt               DateTime                  @default(now())
  processedAt             DateTime?

  @@unique([batchId, rowNumber])
  @@index([batchId, groupId])
  @@index([batchId, state])
}

model EmployeeAudit {
  id                  String               @id @default(uuid())
  employeeId          String?
  employee            Employee?            @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  actorRole           String
  actorId             String
  action              String
  requestId           String
  reason              String?
  changedFields       Json
  sourceImportBatchId String?
  sourceImportBatch   EmployeeImportBatch? @relation(fields: [sourceImportBatchId], references: [id], onDelete: SetNull)
  createdAt           DateTime             @default(now())

  @@index([employeeId, createdAt])
  @@index([sourceImportBatchId])
}

model EmployeeOfflineSession {
  id          String    @id @default(uuid())
  tokenHash   String    @unique
  accountId   String
  employee    Employee  @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  origin      String
  authVersion Int
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([accountId, expiresAt])
}

model EmployeeOfflineReceipt {
  id          String   @id @default(uuid())
  accountId   String
  employee    Employee @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  requestId   String
  requestHash String
  reference   String
  scannedAt   DateTime
  receivedAt  DateTime @default(now())
  result      Json

  @@unique([accountId, requestId])
  @@index([receivedAt])
}
