generator client {
  provider     = "prisma-client-js"
  output       = "../node_modules/.prisma/client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Student {
  ra              String        @id
  accountId       String        @unique @default(dbgenerated("(gen_random_uuid())::text"))
  course          String
  status          String
  name            String
  admission       String
  email           String        @unique
  cpf             String?       @unique
  qrcode          String?       @unique
  photo           String?
  birthDate       DateTime?
  dueDate         DateTime
  password        String
  lastLogin       DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  photoStatus     PhotoStatus   @default(PENDING)
  rejectionReason String?
  attendances     Attendance[]
  certificates    Certificate[]
}

model StudentLog {
  id             Int      @id @default(autoincrement())
  ra             String
  course         String
  status         String
  name           String
  admission      String
  email          String
  cpf            String
  birthDate      DateTime
  dueDate        DateTime
  deletedAt      DateTime @default(now())
  deletionReason String   @default("Prazo de 5 anos após admissão encerrado")
}

model Secretary {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  dueDate         DateTime
  password        String
  birthDate       DateTime
  lastLogin       DateTime?
  events          Event[]   @relation("EventCreatedBy")
  cancelledEvents Event[]   @relation("EventCancelledBy")
  creditAudits    ProjectCreditAudit[]
}

model Event {
  id                 String            @id @default(uuid())
  title              String
  description        String?
  speaker            String
  location           String
  startsAt           DateTime
  endsAt             DateTime
  workloadMinutes    Int
  status             EventStatus       @default(SCHEDULED)
  certificateEnabled Boolean           @default(true)
  createdById        Int?
  createdBy          Secretary?        @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelReason       String?
  cancelledAt        DateTime?
  cancelledById      Int?
  cancelledBy        Secretary?        @relation("EventCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  checkpoints        EventCheckpoint[]
  attendances        Attendance[]
  certificates       Certificate[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([createdById])
  @@index([cancelledById])
}

model EventCheckpoint {
  id           String                  @id @default(uuid())
  eventId      String
  event        Event                   @relation(fields: [eventId], references: [id], onDelete: Restrict)
  type         CheckpointType
  isOpen       Boolean                 @default(false)
  openedAt     DateTime?
  closedAt     DateTime?
  version      Int                     @default(1)
  qrReferences AttendanceQrReference[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@unique([eventId, type])
}

model AttendanceQrReference {
  id                String          @id @default(uuid())
  referenceHash     String          @unique
  checkpointId      String
  checkpoint        EventCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  checkpointVersion Int
  jwtToken          String
  expiresAt         DateTime
  createdAt         DateTime        @default(now())

  @@index([expiresAt])
  @@index([checkpointId, checkpointVersion])
}

model Attendance {
  id               String           @id @default(uuid())
  eventId          String
  event            Event            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  studentRa        String
  studentName      String
  studentCourse    String
  studentAccountId String
  studentRefRa     String?
  student          Student?         @relation(fields: [studentRefRa], references: [ra], onDelete: SetNull)
  checkInAt        DateTime?
  checkOutAt       DateTime?
  status           AttendanceStatus @default(CHECKED_IN)
  certificate      Certificate?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([eventId, studentRa])
  @@index([studentRefRa, studentAccountId])
}

model Certificate {
  id               String     @id @default(uuid())
  eventId          String
  event            Event      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  studentRa        String
  studentAccountId String
  studentRefRa     String?
  student          Student?   @relation(fields: [studentRefRa], references: [ra], onDelete: SetNull)
  attendanceId     String     @unique
  attendance       Attendance @relation(fields: [attendanceId], references: [id], onDelete: Restrict)
  verificationCode String     @unique
  payloadSnapshot  Json
  issuedAt         DateTime   @default(now())
  revokedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([eventId, studentRa])
  @@index([studentRefRa, studentAccountId])
}

model VerificationCode {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)
}

enum PhotoStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CheckpointType {
  CHECK_IN
  CHECK_OUT
}

enum AttendanceStatus {
  CHECKED_IN
  CONFIRMED
}

enum ProjectContributorStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProjectCreditAuditAction {
  CREATED
  UPDATED
  DRAFT_SAVED
  PUBLISHED
  ARCHIVED
  RESTORED
  PHOTO_REPLACED
  PHOTO_REMOVED
}

enum ProjectCreditAssetStatus {
  PENDING
  PROCESSED
  FAILED
}

enum ProjectContributorLinkKind {
  GITHUB
  LINKEDIN
  EMAIL
  EXTERNAL
}

model ProjectContributor {
  id                String                             @id @default(uuid())
  slug              String                             @unique
  name              String
  status            ProjectContributorStatus           @default(DRAFT)
  draftVersion      Int                                @default(1)
  publishedVersion  Int?
  publishedSnapshot Json?
  photoUrl          String?
  photoStorageKey   String?
  photoPendingKey   String?
  photoConfirmed    Boolean                            @default(false)
  profileConfirmed  Boolean                            @default(false)
  archiveReason     String?
  archivedAt        DateTime?
  publishedAt       DateTime?
  createdAt         DateTime                           @default(now())
  updatedAt         DateTime                           @updatedAt
  participations    ProjectContributionParticipation[]
  links             ProjectContributorLink[]
  audits            ProjectCreditAudit[]

  @@index([status])
  @@index([name])
}

model ProjectContributionParticipation {
  id            String             @id @default(uuid())
  contributorId String
  contributor   ProjectContributor @relation(fields: [contributorId], references: [id], onDelete: Cascade)
  semester      String
  course        String?
  roles         String[]
  contribution  String?
  confirmed     Boolean            @default(false)
  order         Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([contributorId, semester])
  @@index([contributorId])
}

model ProjectContributorLink {
  id            String                     @id @default(uuid())
  contributorId String
  contributor   ProjectContributor        @relation(fields: [contributorId], references: [id], onDelete: Cascade)
  kind          ProjectContributorLinkKind @default(EXTERNAL)
  label         String
  url           String
  order         Int                        @default(0)
  confirmed     Boolean                    @default(false)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@unique([contributorId, url])
  @@index([contributorId])
}

model ProjectCreditAudit {
  id                     String                   @id @default(uuid())
  contributorId          String
  contributor            ProjectContributor       @relation(fields: [contributorId], references: [id], onDelete: Cascade)
  action                 ProjectCreditAuditAction
  performedBySecretaryId Int?
  performedBySecretary   Secretary?               @relation(fields: [performedBySecretaryId], references: [id], onDelete: SetNull)
  performedByName        String?
  beforeSnapshot         Json?
  afterSnapshot          Json?
  metadata               Json?
  createdAt              DateTime                 @default(now())

  @@index([contributorId])
  @@index([performedBySecretaryId])
}

model ProjectCreditAssetCleanup {
  id           String                   @id @default(uuid())
  storageKey   String
  source       String                   @default("CREDITS_PHOTO")
  status       ProjectCreditAssetStatus @default(PENDING)
  attempts     Int                      @default(0)
  lastError    String?
  scheduledFor DateTime                 @default(now())
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([status, scheduledFor])
}
